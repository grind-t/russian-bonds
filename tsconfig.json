// https://nodejs.org/api/typescript.html#type-stripping
{
	"compilerOptions": {
		"noEmit": true,
		"target": "esnext",
		"module": "nodenext",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["src", "env.d.ts"]
}
