{
  "name": "@grind-t/russian-bonds",
  "version": "1.1.12",
  "homepage": "https://github.com/grind-t/russian-bonds#readme",
  "bugs": {
    "url": "https://github.com/grind-t/russian-bonds/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grind-t/russian-bonds.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --env-file=.env --experimental-transform-types --watch playground.ts",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "test:unit": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.unit.test.ts\"",
    "test:e2e": "node --env-file-if-exists=.env --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.e2e.test.ts\"",
    "test": "node --env-file-if-exists=.env --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "build": "tsdown",
    "export": "node --env-file=.env --experimental-transform-types scripts/export.ts"
  },
  "dependencies": {
    "@grind-t/cbr-ratings": "^1.0.4",
    "@grind-t/moex": "^1.3.1",
    "@grind-t/t-invest": "^1.0.2",
    "@grind-t/toolkit": "^3.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@grind-t/analytics": "^1.0.1",
    "@types/node": "latest",
    "@webcarrot/xirr": "^3.0.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tsdown": "latest",
    "typescript": "latest"
  }
}
